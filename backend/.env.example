# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,https://www.hindustanprojects.in,https://hindbuilding.hindustanprojects.in

# ==========================================
# Database Connection (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/hipro_db?schema=public"

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=your-super-secure-jwt-secret-replace-in-production

# Initial Root Admin Credentials (Auto-created on first server boot if absent)
ADMIN_EMAIL=admin@hindustanprojects.in
ADMIN_PASSWORD=change-this-secure-password
ADMIN_NAME="HiPRO Administrator"

# ==========================================
# Cloudinary Storage (Media / File Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ==========================================
# SMTP Email Service (Hostinger / Custom SMTP)
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@hindustanprojects.in
SMTP_PASS=
HBS_SMTP_USER=hbs@hindustanprojects.in
DAILY_LIMIT=200
RATE_LIMIT_PER_MINUTE=5

# Development Safety Guards
# ALLOW_DEV_CLOUDINARY_UPLOADS: set true only to deliberately test Cloudinary in dev.
#   Default false — all /api/upload calls return mock URLs in development.
# ALLOW_PRODUCTION_SEED: Authorizes HBS runtime API seeding (POST /api/hbs/seed and auto-seed
#   in GET /api/hbs/services) when NODE_ENV=production. Never set in local .env.
# ALLOW_REMOTE_SEED: Authorizes standalone CLI seed scripts (prisma/seed*, create-admin) to
#   connect to remote databases when NODE_ENV=production. Never set in local .env.
# TARGET_DB_HOST_CONFIRMATION: Exact parsed hostname of the remote database (e.g. ep-xyz.aws.neon.tech).
#   Required alongside ALLOW_REMOTE_SEED=true (or ALLOW_PRODUCTION_SEED=true) in production.
# TARGET_DB_NAME_CONFIRMATION: Exact database name of the remote database (e.g. hipro_production).
#   Required alongside ALLOW_REMOTE_SEED=true (or ALLOW_PRODUCTION_SEED=true) in production.
#
# NOTE: ENABLE_LIVE_EMAIL_IN_DEV has been REMOVED.
#   Email delivery is always intercepted outside production by emailSender.ts.
#   No env flag can bypass the fail-closed email guard in non-production mode.
ALLOW_DEV_CLOUDINARY_UPLOADS=false
ALLOW_PRODUCTION_SEED=false
ALLOW_REMOTE_SEED=false
# TARGET_DB_HOST_CONFIRMATION=
# TARGET_DB_NAME_CONFIRMATION=

# Optional TLS bypass for self-signed certificates in local dev (leave false in prod)
# SMTP_IGNORE_TLS_ERRORS=false

# ==========================================
# Web Push Notifications (VAPID)
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@hindustanprojects.in

# ==========================================
# Free-Tier Keep-Alive Daemon (Render / Railway)
# ==========================================
DISABLE_KEEP_ALIVE=false
KEEP_ALIVE_INTERVAL_MS=600000
# KEEP_ALIVE_URL=https://hipro-web.onrender.com
