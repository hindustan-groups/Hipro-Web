generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    String   @default("new") // "new", "read", "replied"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  projectType String
  budget      String
  location    String
  description String
  timeline    String?
  status      String   @default("pending") // "pending", "reviewed", "approved", "rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  // Primary Identification & SEO Routing
  id                String    @id @default(cuid())
  slug              String?   @unique
  title             String
  shortDescription  String?   @db.Text
  description       String    @db.Text
  category          String
  subCategories     String?

  // Commercial, Stakeholder & Technical Specifications (AEO Entities)
  client            String?
  owner             String?
  area              String?
  services          String?
  location          String
  date              String
  completionDate    String?
  highlights        String?   @db.Text

  // Geographic Grounding & Local Discovery (GEO Attributes — Zero Defaults)
  city              String?
  district          String?
  state             String?
  country           String?
  postalCode        String?
  targetLocation    String?
  latitude          Float?
  longitude         Float?
  googleMapsUrl     String?

  // Visual Media & Video Engine (Media SEO)
  image             String
  imageAlt          String?
  imageCaption      String?
  images            String?   @db.Text
  galleryDetails    String?   @db.Text
  videoUrl          String?
  videoType         String?   @default("none")
  videoTitle        String?
  videoDescription  String?   @db.Text
  videoPoster       String?

  // Structured Q&A (AEO Verified FAQ Section)
  faqs              String?   @db.Text

  // Operational Status & Publishing Workflow (New projects default to draft)
  status            String    @default("active")
  publishStatus     String    @default("draft")
  publishedAt       DateTime?
  featured          Boolean   @default(false)
  order             Int       @default(0)

  // SEO, Crawling Directives & Social Graph Controls
  metaTitle         String?
  metaDescription   String?   @db.Text
  focusKeywords     String?
  secondaryKeywords String?
  canonicalUrl      String?
  ogImage           String?
  noIndex           Boolean   @default(false)
  noFollow          Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([publishStatus])
  @@index([city])
}

model Service {
  id                     String    @id @default(cuid())
  title                  String
  description            String
  category               String    @default("Design & Planning")
  icon                   String
  features               String    // Storing JSON stringified array of features
  image                  String
  order                  Int       @default(0)
  active                 Boolean   @default(true)

  // Rich Content & Detail Sections
  badge                  String?
  tagline                String?
  metaTitle              String?
  metaDescription        String?
  overviewHeading        String?
  overviewParagraphs     String?   // JSON array of strings
  detailedCapabilities   String?   // JSON array: [{ title, description, points: string[] }]
  applicationsHeading    String?
  applications           String?   // JSON array: [{ title, description }]
  stagesHeading          String?
  stages                 String?   // JSON array: [{ step, title, description }]
  deliverablesHeading    String?
  deliverables           String?   // JSON array of strings
  whyChooseHeading       String?
  whyChoosePoints        String?   // JSON array: [{ title, description }]
  faqs                   String?   // JSON array: [{ question, answer }]
  indicativeRatesNotice  String?   // JSON object: { heading, description, tiers }

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  image     String?
  rating    Int
  text      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Stats {
  id        String   @id @default(cuid())
  label     String
  value     String
  icon      String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Settings {
  id                     String   @id @default(cuid())
  cloudinaryCloudName    String
  cloudinaryUploadPreset String
  navigationConfig       String?  // JSON string

  // Phase 2: Contact Info
  companyEmail           String?
  companyPhone           String?
  companyAddress         String?
  socialLinks            String?  // JSON string (e.g. { facebook: "url", linkedin: "url" })

  // Phase 3: Page Content
  pageContent            String?  // JSON string (e.g. { aboutHero: "...", aboutStory: "..." })

  updatedAt              DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(cuid())
  image     String
  tagline   String
  title     String
  subtitle  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  img       String
  bio       String?
  isFounder Boolean  @default(false)
  instagram String?
  linkedin  String?
  facebook  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guarantee {
  id          String   @id @default(cuid())
  badge       String
  title       String
  description String
  bg          String
  accent      String
  image       String
  hasShield   Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  role       String
  experience String
  cvUrl      String
  status     String   @default("new") // "new", "reviewed", "rejected"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("Full-Time") // "Full-Time", "Part-Time", "Contract"
  location    String
  description String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  excerpt           String
  content           String
  image             String
  date              String
  author            String
  authorRole        String?
  authorBio         String?
  authorImage       String?
  authorProfileUrl  String?
  category          String
  active            Boolean   @default(true)
  metaTitle         String?
  metaDescription   String?
  keywords          String?

  // Media
  imageAlt          String?
  imageTitle        String?
  imageCaption      String?

  // Publishing
  status            String    @default("published") // "draft", "published", "unpublished"
  publishDate       DateTime?

  // SEO & GEO metadata
  primaryKeyword    String?
  secondaryKeywords String?
  geoKeywords       String?
  targetLocation    String?
  searchIntent      String?   // "informational", "commercial", "transactional", "navigational"

  // Structured Content & Linking (JSON stringified)
  faqs              String?   // JSON array: [{ question, answer }]
  internalLinks     String?   // JSON array: [{ label, url }]
  relatedPostIds    String?   // JSON array of slugs or IDs
  customCta         String?   // JSON object: { title, description, buttonText, buttonUrl }

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AdminUser {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  role        String   @default("employee")
  permissions String?
  createdAt   DateTime @default(now())
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
}

model AboutPageContent {
  id                    String    @id @default("singleton")
  status                String    @default("published") // "draft", "published", "unpublished"
  publishedAt           DateTime? @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Hero
  heroBadge             String    @default("Engineering · Construction · Infrastructure · Est. 2019")
  heroHeadingPrefix     String    @default("Engineering")
  heroHeadingAccent     String    @default("Precision.")
  heroHeadingSuffix     String    @default("Built for Execution.")
  heroDescription       String    @db.Text
  heroHighlights        String    @db.Text // JSON: Array<{ label: string, value: string }>
  heroPrimaryCtaText    String    @default("Explore Capabilities")
  heroSecondaryCtaText  String    @default("Estimate Build Cost")

  // Executive
  executiveBadge        String    @default("Executive Leadership")
  executiveTitle        String    @default("Committed to Engineering Discipline & Responsible Site Execution")
  executiveStatement    String    @db.Text // JSON: string[] (paragraphs)
  founderImage          String?
  founderImageAlt       String?   @default("Yogesh Kharol, Founder & Director")

  // Profile / Facts
  companyFacts          String    @db.Text // JSON: Array<{ label: string, value: string }>

  // Mission & Vision
  missionTag            String    @default("Corporate Mission")
  missionTitle          String    @default("Engineered For Durability")
  missionDescription    String    @db.Text
  visionTag             String    @default("Corporate Vision")
  visionTitle           String    @default("Trusted Regional Partner")
  visionDescription     String    @db.Text

  // Principles
  engineeringPrinciples String    @db.Text // JSON: Array<{ title: string, desc: string }>

  // Execution Stages
  executionStages       String    @db.Text // JSON: Array<{ step: string, title: string, desc: string, serviceName: string, serviceSlug: string }>

  // Capabilities & Sectors
  capabilitiesSectors   String    @db.Text // JSON: Array<{ sector: string, description: string, services: string[], primarySlug: string }>

  // Quality & Commitments
  qualityHeading        String    @default("Committed to Quality & Responsible Engineering")
  qualitySubtitle       String    @db.Text
  qualityCommitments    String    @db.Text // JSON: Array<{ title: string, desc: string }>

  // Regional Focus
  regionalHeading       String    @default("Headquartered in Bhilwara. Serving Rajasthan.")
  regionalDescription   String    @db.Text
  regionalBullets       String    @db.Text // JSON: string[]

  // SEO & Social Meta
  metaTitle             String?
  metaDescription       String?   @db.Text
  canonicalUrl          String?   @default("/about")
  targetLocation        String?   @default("Bhilwara, Rajasthan")
  geoKeywords           String?
  ogTitle               String?
  ogDescription         String?   @db.Text
  ogImage               String?
  twitterTitle          String?
  twitterDescription    String?   @db.Text
  twitterImage          String?
}

// ==================================================
// HIND BUILDING SOLUTIONS (HBS) SUB-BRAND MODELS
// Dedicated models for complete isolation from HiPRO
// ==================================================

model HbsContent {
  id                     String    @id @default("singleton")
  // General Brand Settings
  brandName              String    @default("Hind Building Solutions")
  logo                   String?
  logoPrimary            String?
  logoDark               String?
  logoMark               String?
  logoMobile             String?
  favicon                String?
  ogDefaultImage         String?
  gaMeasurementId        String?
  emergencyNotice        String?
  privacyPolicyUrl       String?   @default("/privacy-policy")
  termsUrl               String?   @default("/terms")
  tagline                String    @default("Building Repair, Maintenance, Protection & Services")
  phone                  String    @default("+91 75970 00601")
  whatsapp               String    @default("+91 75970 00601")
  email                  String    @default("hbs@hindustanprojects.in")
  address                String    @default("Opposite Mukherji Park, Above Bhagwati Coffee House, Bhopal Ganj, Bhilwara, Rajasthan 311001")
  businessHours          String    @default("Mon - Sat: 9:00 AM - 7:00 PM")
  socialLinks            String?   @db.Text // JSON string
  ctaSettings            String?   @db.Text // JSON string: { buttonText, phone, emergencyNotice }

  // Home Page CMS
  heroTitle              String    @default("Complete Building Repair, Maintenance & Protection")
  heroSubtitle           String    @default("Specialized engineering care for homes, apartments, and commercial buildings across Rajasthan.")
  heroImage              String?
  heroCtas               String?   @db.Text // JSON string: [{ label, link, variant }]
  heroHighlights         String?   @db.Text // JSON string: Array<{ label: string, icon?: string }>
  whyChooseUs            String?   @db.Text // JSON string: [{ title, description, icon }]
  stats                  String?   @db.Text // JSON string: [{ label, value, icon }]
  processSteps           String?   @db.Text // JSON string: Array<{ step: string, title: string, desc: string }>
  guaranteeSection       String?   @db.Text // JSON string: { title?: string, description?: string, badge?: string, partners?: string[] }
  homeFinalCta           String?   @db.Text // JSON string

  // About Page CMS
  aboutStory             String?   @db.Text
  mission                String?   @db.Text
  vision                 String?   @db.Text
  team                   String?   @db.Text // JSON string
  whyChoosePoints        String?   @db.Text // JSON string
  aboutImages            String?   @db.Text // JSON string

  // SEO & Social
  metaTitle              String?
  metaDescription        String?   @db.Text
  canonicalUrl           String?   @default("https://hindbuilding.hindustanprojects.in")
  ogImage                String?
  twitterImage           String?
  jsonLd                 String?   @db.Text

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model HbsService {
  id               String    @id @default(cuid())
  serviceNumber    String?   // e.g. "01", "02" ... "19"
  title            String
  hindiTitle       String?
  slug             String    @unique
  shortDescription String?   @db.Text
  fullDescription  String?   @db.Text
  image            String?
  icon             String?
  features         String?   @db.Text // JSON array of feature points
  benefits         String?   @db.Text // JSON string: string[]
  processSteps     String?   @db.Text // JSON string: Array<{ step: string, title: string, desc: string }>
  warrantyDetails  String?   @db.Text
  pricingEstimate  String?
  faqs             String?   @db.Text // JSON string: Array<{ q: string, a: string }>
  galleryImages    String?   @db.Text // JSON string: string[]
  ogImage          String?
  whatsappCtaText  String?
  active           Boolean   @default(true)
  order            Int       @default(0)
  metaTitle        String?
  metaDescription  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([order])
  @@index([active])
}

model HbsProject {
  id                 String    @id @default(cuid())
  slug               String?   @unique
  title              String
  location           String?
  serviceCategory    String?
  clientType         String?   // e.g. "Residential Villa", "Apartment Complex", "Commercial Complex", "Industrial Plant"
  description        String?   @db.Text
  scopeOfWork        String?   @db.Text // JSON string: string[]
  problemStatement   String?   @db.Text
  solutionStatement  String?   @db.Text
  resultStatement    String?   @db.Text
  areaTreated        String?   // e.g. "12,500 sq.ft"
  durationDays       Int?
  images             String?   @db.Text // JSON array of image URLs
  beforeAfterImages  String?   @db.Text // JSON array: [{ before: string, after: string, title?: string }]
  date               String?
  status             String    @default("completed")
  featured           Boolean   @default(false)
  active             Boolean   @default(true)
  order              Int       @default(0)
  metaTitle          String?
  metaDescription    String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([order])
  @@index([active])
  @@index([featured])
}

model HbsTestimonial {
  id              String   @id @default(cuid())
  name            String
  designation     String?
  content         String   @db.Text
  image           String?
  rating          Int      @default(5)
  serviceSlug     String?
  serviceCategory String?
  location        String?
  projectType     String?
  projectDate     String?
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([order])
  @@index([active])
  @@index([featured])
}

model HbsLead {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  selectedService String?
  message         String?  @db.Text
  source          String   @default("hbs_website") // "hbs_quote_modal", "hbs_contact_form", etc.
  status          String   @default("NEW") // "NEW", "CONTACTED", "FOLLOW_UP", "QUOTATION_SENT", "CONVERTED", "LOST", "SPAM"
  assignedTo      String?
  quotationAmount Float?
  priority        String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  internalNotes   String?  @db.Text // JSON string: Array<{ author: string, note: string, createdAt: string }>
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ==================================================
// AUTOMAIL BULK & CAMPAIGN ENGINE (MULTI-BRAND)
// Supports HiPRO, Hind Build (HBS), and custom brands
// ==================================================

model AutomailContact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  brand     String   @default("all") // "all" | "hipro" | "hbs" | custom brand tag
  tags      String?  // comma-separated or JSON
  source    String?  @default("manual") // "manual" | "csv_import" | "hipro_leads" | "hbs_leads" | "newsletter"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([source])
}

model AutomailCampaign {
  id              String            @id @default(cuid())
  name            String
  subject         String
  brand           String            @default("all") // "all" | "hipro" | "hbs" | custom
  senderName      String?
  senderEmail     String?
  replyTo         String?
  htmlBody        String            @db.Text
  textBody        String?           @db.Text
  template        String?           @default("custom") // "custom" | "hipro_official" | "hbs_official"
  status          String            @default("draft") // "draft" | "queued" | "sending" | "completed" | "paused" | "failed"
  targetAudience  String?           @default("all") // "all" | "hipro_only" | "hbs_only" | "selected"
  totalRecipients Int               @default(0)
  sentCount       Int               @default(0)
  failedCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sentAt          DateTime?
  logs            AutomailSendLog[]

  @@index([brand])
  @@index([status])
}

model AutomailSendLog {
  id           String           @id @default(cuid())
  campaignId   String
  contactEmail String
  contactName  String?
  brand        String?          @default("all")
  status       String           @default("queued") // "queued" | "sent" | "failed"
  error        String?          @db.Text
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  campaign     AutomailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
}

model AutomailDailyStat {
  date        String @id // YYYY-MM-DD
  totalSent   Int    @default(0)
  totalFailed Int    @default(0)
}

model AutomailSetting {
  id                 String   @id @default("singleton")
  deliveryMethod     String   @default("smtp") // "smtp" | "hostinger_api"
  hostingerApiToken  String?  @default("")
  hostingerMailboxId String?  @default("")
  smtpHost           String   @default("smtp.hostinger.com")
  smtpPort           Int      @default(465)
  smtpUser           String   @default("info@hindustanprojects.in")
  smtpPass           String?  @default("")
  senderNameHipro    String   @default("Hindustan Projects")
  senderEmailHipro   String   @default("info@hindustanprojects.in")
  senderNameHbs      String   @default("Hind Building Solutions")
  senderEmailHbs     String   @default("hbs@hindustanprojects.in")
  dailyLimit         Int      @default(200)
  rateLimitPerMinute Int      @default(15)
  replyTo            String   @default("info@hindustanprojects.in")
  updatedAt          DateTime @updatedAt
}

// ===================================================================
// HINDUSTAN PROJECTS — VENDOR & CONTRACTOR EMPANELMENT PORTAL MODELS
// ===================================================================

model VendorApplication {
  id                    String            @id @default(cuid())
  trackingId            String            @unique // e.g. "HP-EMP-849201"
  hashSignature         String?           // SHA-256 audit signature
  status                String            @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_VERIFICATION, TECHNICAL_AUDIT, FINANCIAL_REVIEW, APPROVED, REJECTED, BLACKLISTED
  currentStage          String            @default("Initial Screening")
  tier                  String            @default("PROVISIONAL") // CLASS_A, CLASS_B, CLASS_C, PROVISIONAL
  
  // Category & Core Competence
  category              String            // Civil, MEP, Suppliers, Architects, Equipment, Logistics
  primaryRole           String?
  specialization        String?
  skillsDetails         String?           @db.Text
  teamSize              String?
  
  // Enterprise & Legal Entity Details
  companyName           String
  entityType            String            @default("PROPRIETORSHIP") // PROPRIETORSHIP, PARTNERSHIP, PRIVATE_LIMITED, PUBLIC_LIMITED, LLP, INDIVIDUAL
  establishmentYear     String?
  ownerName             String?
  ownerContact          String?
  contactName           String
  designation           String?
  email                 String
  phone                 String
  
  // Registered Office & Local Grounding
  address               String            @db.Text
  city                  String
  district              String?
  state                 String
  pincode               String
  
  // Statutory Compliance & Tax Numbers
  gstin                 String?
  isGstVerified         Boolean           @default(false)
  pan                   String
  aadharNo              String?
  msmeUdyamNo           String?
  
  // Financial Credentials & Banking
  bankName              String?
  accountNumber         String?
  ifscCode              String?
  turnoverYear1         String?           // FY 2023-24
  turnoverYear2         String?           // FY 2024-25
  turnoverYear3         String?           // FY 2025-26
  largestOrderValue     String?
  existingEmpanelments  String?           @db.Text
  
  // Paperless Document Vault (Cloudinary / Storage Secure URLs)
  gstCertificateUrl     String?
  panCardUrl            String?
  bankChequeUrl         String?
  workExperienceDocUrl  String?
  passportPhotoUrl      String?
  signatureUrl          String?           @db.Text
  signatoryName         String?
  
  // Internal Verification & Corporate Grading
  eligibilityScore      Int               @default(0) // 0 - 100 points
  adminRemarks          String?           @db.Text
  assignedOfficerId     String?           // Delegated Staff member ID
  assignedOfficerName   String?
  ceoSigned             Boolean           @default(false)
  ceoSignedDate         DateTime?
  digitalCertificateUrl String?
  
  // Security & Audit
  ipAddress             String?
  submittedAt           DateTime          @default(now())
  approvedAt            DateTime?
  updatedAt             DateTime          @updatedAt

  // Relations
  bids                  VendorBid[]
  gatePasses            SiteGatePass[]
  workOrders            VendorWorkOrder[]
  invoices              VendorInvoice[]
  tickets               EmpanelmentTicket[]

  @@index([status])
  @@index([category])
  @@index([tier])
  @@index([email])
  @@index([phone])
  @@index([city])
}

model EmpanelmentTender {
  id                    String      @id @default(cuid())
  tenderNo              String      @unique // e.g. "HP-TND-2026-08"
  title                 String
  category              String      // Civil, MEP, Suppliers, etc.
  location              String
  estimatedBudget       String
  emdAmount             String?
  publishDate           DateTime    @default(now())
  dueDate               DateTime
  status                String      @default("ACTIVE") // ACTIVE, EVALUATION, AWARDED, ARCHIVED
  scopeOfWork           String      @db.Text
  documentUrl           String?
  bidsCount             Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  bids                  VendorBid[]

  @@index([status])
  @@index([category])
}

model VendorBid {
  id                    String             @id @default(cuid())
  tenderId              String
  vendorId              String
  bidAmount             Float
  proposedDays          Int?
  remarks               String?            @db.Text
  status                String             @default("UNDER_REVIEW") // UNDER_REVIEW, SHORTLISTED, ACCEPTED, REJECTED
  submittedAt           DateTime           @default(now())

  tender                EmpanelmentTender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  vendor                VendorApplication  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([vendorId])
  @@index([status])
}

model SiteGatePass {
  id                    String             @id @default(cuid())
  passCode              String             @unique // e.g. "HP-GP-98214"
  vendorId              String
  visitorName           String
  workerCount           Int                @default(1)
  vehicleNo             String?
  siteLocation          String
  validFrom             DateTime           @default(now())
  validTill             DateTime
  status                String             @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  securityRemarks       String?
  createdAt             DateTime           @default(now())

  vendor                VendorApplication  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([passCode])
  @@index([status])
}

model VendorWorkOrder {
  id                    String             @id @default(cuid())
  workOrderNo           String             @unique // e.g. "HP-WO-2026-44"
  vendorId              String
  projectName           String
  packageTitle          String
  contractAmount        Float
  startDate             DateTime?
  completionTargetDate  DateTime?
  progressPercent       Int                @default(0)
  status                String             @default("IN_EXECUTION") // IN_EXECUTION, COMPLETED, ON_HOLD
  contractDocUrl        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  vendor                VendorApplication  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invoices              VendorInvoice[]

  @@index([vendorId])
}

model VendorInvoice {
  id                    String             @id @default(cuid())
  invoiceNo             String             @unique // e.g. "INV-2026-091"
  workOrderId           String?
  vendorId              String
  amount                Float
  tdsDeduction          Float              @default(0)
  netPayable            Float
  status                String             @default("UNDER_REVIEW") // UNDER_REVIEW, APPROVED, PAID, DISPUTED
  rtgsRef               String?
  paidAt                DateTime?
  createdAt             DateTime           @default(now())

  vendor                VendorApplication  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workOrder             VendorWorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([status])
}

model EmpanelmentTicket {
  id                    String             @id @default(cuid())
  ticketNo              String             @unique // e.g. "HP-TCK-712"
  vendorId              String
  subject               String
  category              String
  priority              String             @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  message               String             @db.Text
  status                String             @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminReply            String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  vendor                VendorApplication  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model EmpanelmentContent {
  id                     String    @id @default("singleton")
  // Brand & Contact Coordinates
  portalName             String    @default("Hindustan Projects")
  tagline                String    @default("Engineering - Construction - Infrastructure")
  phone                  String    @default("+91 98765 43210")
  email                  String    @default("procurement@hindustanprojects.in")
  address                String    @default("Hindustan Projects, Bhilwara, Rajasthan, India")
  supportWhatsapp        String    @default("+91 98765 43210")
  socialLinks            String?   @db.Text

  // Hero Section
  heroBadge              String    @default("VENDOR PORTAL")
  heroTitlePrefix        String    @default("Partner with")
  heroTitleHighlight     String    @default("Hindustan Projects")
  heroSubtitle           String    @default("Join our local vendor network for construction materials, services and project opportunities across Rajasthan and beyond.")
  heroRegisterBtnText    String    @default("Register as a Vendor")
  heroLoginBtnText       String    @default("Vendor Login")
  heroImageUrl           String?   @default("/images/empanelment/hero-engineers.jpg")
  heroOverlayBadge       String    @default("Building Stronger Partnerships for a Better Rajasthan.")
  heroPills              String?   @db.Text

  // Stats Counter Bar
  stats                  String?   @db.Text

  // Categories Section
  categoriesBadge        String    @default("CATEGORIES")
  categoriesTitle        String    @default("Supply to Our Construction Projects")
  categoriesSubtitle     String    @default("We source high-quality materials, services and solutions from trusted local vendors to support our construction and infrastructure projects across Rajasthan.")
  categoriesList         String?   @db.Text

  // Process / How It Works
  processBadge           String    @default("HOW IT WORKS")
  processTitle           String    @default("Vendor Registration Process")
  processSubtitle        String    @default("Get registered in a few simple steps and become a part of Hindustan Projects' approved vendor network.")
  processSteps           String?   @db.Text

  // Benefits
  benefitsBadge          String    @default("WHY PARTNER WITH US?")
  benefitsTitle          String    @default("Benefits for Our Vendors")
  benefitsSubtitle       String    @default("We believe in long-term relationships with our vendors and suppliers, creating value for both business and society.")
  benefitsList           String?   @db.Text

  // Dark Impact Section
  impactBadge            String    @default("OUR IMPACT")
  impactTitle            String    @default("Building a Stronger Rajasthan Together")
  impactSubtitle         String    @default("Empowering local businesses, creating opportunities and building a better Rajasthan through responsible and sustainable infrastructure development.")
  impactBtnText          String    @default("Join Our Vendor Network")
  impactPillars          String?   @db.Text
  impactImageUrl         String?   @default("/images/empanelment/impact-skyline.jpg")

  // Documents Required
  docsBadge              String    @default("DOCUMENTS REQUIRED")
  docsTitle              String    @default("Get Ready for Registration")
  docsSubtitle           String    @default("Keep the following documents ready (as applicable) to complete your vendor registration smoothly.")
  docsList               String?   @db.Text

  // FAQs
  faqBadge               String    @default("FREQUENTLY ASKED QUESTIONS")
  faqTitle               String    @default("Quick Answers")
  faqSubtitle            String    @default("Find answers to common questions about vendor registration, procurement and working with Hindustan Projects.")
  faqsList               String?   @db.Text

  // Bottom Red CTA Banner
  ctaBadge               String    @default("BE A PART OF OUR JOURNEY")
  ctaTitle               String    @default("Let's Build a Stronger, Self-Reliant Rajasthan.")
  ctaSubtitle            String    @default("Register as a vendor today and become a part of Hindustan Projects' growing network.")
  ctaBtnText             String    @default("Register Now")

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

